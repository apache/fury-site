# This redirect must run before Apache handles the request as a 404; client-side
# Docusaurus redirects never execute when the origin serves its stock 404 page.
RedirectMatch 301 "^/docs/guide/rust/?$" "https://fory.apache.org/docs/object-serialization/rust/"

# Keep arbitrary missing URLs temporary so stale typos are not cached forever.
ErrorDocument 404 "https://fory.apache.org/"
